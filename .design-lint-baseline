# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 5
padding-literal 2
spacing-literal 0
radius-literal 1
hex-color 0
raw-color 0
raw-control 3
file-length 6
try-bang 0
force-cast 0
force-unwrap 2
print 0
opacity-literal 3
frame-literal 2
chamfer-literal 0
motion-literal 0
